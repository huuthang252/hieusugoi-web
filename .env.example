# Hieusugoi Desktop - Environment Variables
# Copy file nay thanh .env va dien gia tri thuc:
#   cp .env.example .env
#
# .env da co trong .gitignore - KHONG commit .env
# Cho CI/CD: them SUPABASE_URL va SUPABASE_ANON_KEY vao GitHub Secrets

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
